# Server Port
PORT=3000
HOST=0.0.0.0

# MongoDB Connection URI (Leave empty to use the zero-config embedded in-memory MongoDB store)
# Example MongoDB Atlas URI:
# MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/cross_hospital_rebalance?retryWrites=true&w=majority
MONGODB_URI=

# Database Name
DB_NAME=cross_hospital_rebalance

# Google Gemini API Key (Optional - falls back to standard heuristic generator if omitted)
# Get your API key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Gemini Model
GEMINI_MODEL=gemini-3.8-flash

# Simulation Tick Interval in Milliseconds (Default: 3000ms)
SIMULATION_INTERVAL_MS=3000
